# ==============================================================================
# Production Blueprint v5.1 — ВМ №1: Периметр, шлюзы, observability, зеркала
# ==============================================================================
# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env
#   nano .env
#
# ВАЖНО: Все пароли должны быть сильными (минимум 32 символа, случайные).
# Для генерации используйте: openssl rand -base64 32
# ==============================================================================

# ==============================================================================
# PostgreSQL — Auth & Observability (ВМ №1)
# ==============================================================================
# Основная БД для Keycloak, Langfuse и реестра ранов фабрики
POSTGRES_AUTH_USER=factory_auth
POSTGRES_AUTH_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# ==============================================================================
# Keycloak (IdP / LDAP-федерация)
# ==============================================================================
# Публичный URL Keycloak (должен совпадать с сертификатом TLS)
KEYCLOAK_HOSTNAME=https://auth.corp.example.com

# Администратор Keycloak (создаётся при первом запуске)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# Учётная запись Keycloak в PostgreSQL
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# ==============================================================================
# oauth2-proxy (Auth-прокси)
# ==============================================================================
# OIDC-клиент, зарегистрированный в Keycloak
OAUTH2_PROXY_CLIENT_ID=factory-spa
OAUTH2_PROXY_CLIENT_SECRET=<CHANGE_ME_FROM_KEYCLOAK_CLIENT>

# Секрет для подписи cookie (32 байта, base64)
# Генерация: openssl rand -base64 32
OAUTH2_PROXY_COOKIE_SECRET=<32_BYTE_RANDOM_BASE64>

# OIDC Issuer URL (Realm URL в Keycloak)
OAUTH2_PROXY_OIDC_ISSUER_URL=https://auth.corp.example.com/realms/factory

# ==============================================================================
# Redis — Langfuse (инжест трейсов)
# ==============================================================================
# Пароль администратора Redis (для healthcheck и управления)
REDIS_LANGFUSE_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# Пароль ACL-пользователя langfuse_svc (для подключения Langfuse)
REDIS_LANGFUSE_ACL_PASSWORD=<CHANGE_ME_ACL_PASSWORD>

# ==============================================================================
# ClickHouse (трейсы и observations Langfuse)
# ==============================================================================
CLICKHOUSE_USER=langfuse
CLICKHOUSE_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# ==============================================================================
# Langfuse (observability UI/API)
# ==============================================================================
# Учётная запись Langfuse в PostgreSQL
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# Секреты NextAuth (аутентификация в Langfuse UI)
# Генерация: openssl rand -base64 64
LANGFUSE_NEXTAUTH_SECRET=<64_BYTE_RANDOM>

# Публичный URL Langfuse UI
LANGFUSE_NEXTAUTH_URL=https://langfuse.corp.example.com

# Соль для хеширования
LANGFUSE_SALT=<RANDOM_SALT>

# API-ключи Langfuse (для подключения воркеров и gateway)
# Создаются в Langfuse UI после первого запуска
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# ==============================================================================
# SeaweedFS (ВМ №2) — для blob Langfuse
# ==============================================================================
# S3-ключи для доступа к SeaweedFS на ВМ №2
# Создаются при инициализации SeaweedFS
S3_ACCESS_KEY=<SEAWEEED_S3_KEY>
S3_SECRET_KEY=<SEAWEEED_S3_SECRET>

# ==============================================================================
# Gateway → ВМ №2 (Redis фабрики, PostgreSQL runtime)
# ==============================================================================
# Пароль ACL-пользователя agui_svc в Redis фабрики (ВМ №2)
REDIS_FACTORY_ACL_PASSWORD=<CHANGE_ME_ACL_PASSWORD>

# Учётная запись Gateway в PostgreSQL runtime (ВМ №2)
GATEWAY_DB_USER=factory_gateway
GATEWAY_DB_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# ==============================================================================
# Дополнительные настройки (опционально)
# ==============================================================================
# Уровень логирования (debug, info, warning, error)
LOG_LEVEL=info

# Часовой пояс для контейнеров
TZ=Asia/Yekaterinburg