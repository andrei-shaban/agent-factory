# vm1/.env.example
# ==============================================================================
# Production Blueprint v5.2 � �� �1: ��������, �����, observability, �������
# ==============================================================================
# ���������� ���� ���� � .env � ��������� ��������:
#   cp .env.example .env
#   nano .env
#
# �����: ��� ������ ������ ���� �������� (������� 32 �������, ���������).
# ��� ��������� �����������: openssl rand -base64 32
#
# ����������:
#   ������ TLS-���������� �� �������������� �� ������ ��������� � SAN ��� �����:
#     - factory.corp.example.com   (SPA, API, Keycloak �� /auth, oauth2-proxy)
#     - langfuse.corp.example.com  (Langfuse UI)
# ==============================================================================

# ==============================================================================
# ���� / ���������� ������ ��� �� �2
# ==============================================================================
# ����� ����� �� �1, �� ������� ����������� ����� ��� ���� �� �2:
#   - 3000 � ������ ������� � Langfuse (������ �� �2)
#   - 8080 � ������� PyPI (������ �� �2)
# ������ � ���� ������ � ������ ����� ������ ���� ������ �� ���������� ������.
# �� ����������� 0.0.0.0 � ���������� ���������� ���������� ����� �����.
VM1_HOST_IP=127.0.0.1

# ==============================================================================
# ������������ �������� � �� �2
# ==============================================================================
# ����� ����� �� �2 ��� ��������� ���������� � �� �1:
#   - Gateway ? Redis ������� (6379, TLS + ACL agui_svc)
#   - Gateway ? PostgreSQL runtime (5432, ������ �����)
#   - Langfuse ? SeaweedFS S3 (8333, blob events)
# ��� ���������� IP �� �2 � ������������� ���� (�� ���������).
VM2_HOST_IP=127.0.0.1
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://seaweedfs-s3:8333

# ==============================================================================
# PostgreSQL � Auth & Observability (�� �1)
# ==============================================================================
# ���� �� �1 ����������� ������ ���� Keycloak � Langfuse (Blueprint �3.1).
# ������ ����� ������� ���� �� �� �2 � ����� �� ��������.
POSTGRES_AUTH_USER=factory_auth
POSTGRES_AUTH_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# ==============================================================================
# Keycloak (IdP / LDAP-���������)
# ==============================================================================
# ��������� URL Keycloak.
# Keycloak �������� � path-based ������ (��. nginx location /auth/):
# https://factory.corp.example.com/auth
KEYCLOAK_HOSTNAME=https://factory.corp.example.com/auth

# ������������� Keycloak (�������� ��� ������ �������)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# ������� ������ Keycloak � PostgreSQL
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# ==============================================================================
# oauth2-proxy (Auth-������)
# ==============================================================================
# ������� ���������� � ��������� ����� ���������� ��������� (�������� ���������
# �������� OAUTH2_PROXY_). � cfg ��� �� ����������� � ��. ���� 4.

# OIDC-������, ������������������ � Keycloak
OAUTH2_PROXY_CLIENT_ID=factory-spa
OAUTH2_PROXY_CLIENT_SECRET=<CHANGE_ME_FROM_KEYCLOAK_CLIENT>

# ������ ��� ������� cookie (32 �����, base64)
# ���������: openssl rand -base64 32
OAUTH2_PROXY_COOKIE_SECRET=<32_BYTE_RANDOM_BASE64>

# OIDC Issuer URL (Realm URL � Keycloak).
# Path-based: issuer �������� �� ���� �� ������, ��� � �������, ��� ��������� /auth.
OAUTH2_PROXY_OIDC_ISSUER_URL=http://keycloak:8080/auth/realms/factory

# ==============================================================================
# Redis � Langfuse (������ �������)
# ==============================================================================
# ������ �������������� Redis (��� healthcheck � ����������)
REDIS_LANGFUSE_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# ������ ACL-������������ langfuse_svc (��� ����������� Langfuse)
REDIS_LANGFUSE_ACL_PASSWORD=<CHANGE_ME_ACL_PASSWORD>

# ==============================================================================
# ClickHouse (������ � observations Langfuse)
# ==============================================================================
CLICKHOUSE_USER=langfuse
CLICKHOUSE_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# ==============================================================================
# Langfuse (observability UI/API)
# ==============================================================================
# ������� ������ Langfuse � PostgreSQL
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# ������� NextAuth (�������������� � Langfuse UI)
# ���������: openssl rand -base64 64
LANGFUSE_NEXTAUTH_SECRET=<64_BYTE_RANDOM>

# ��������� URL Langfuse UI (��������� vhost, SAN � �����������).
# ������ ��������� � server_name � nginx � ������� � �����������.
LANGFUSE_NEXTAUTH_URL=https://langfuse.corp.example.com

# ���� ��� �����������
LANGFUSE_SALT=<RANDOM_SALT>

# API-����� Langfuse (��� ����������� �������� � gateway)
# ��������� � Langfuse UI ����� ������� �������
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# ==============================================================================
# SeaweedFS (�� �2) � ��� blob Langfuse
# ==============================================================================
# S3-����� ��� ������� � SeaweedFS �� �� �2.
# ��������� ��� ������������� SeaweedFS.
S3_ACCESS_KEY=<SEAWEEED_S3_KEY>
S3_SECRET_KEY=<SEAWEEED_S3_SECRET>

# ==============================================================================
# Gateway ? �� �2 (Redis �������, PostgreSQL runtime)
# ==============================================================================
# ������ ACL-������������ agui_svc � Redis ������� (�� �2)
REDIS_FACTORY_ACL_PASSWORD=<CHANGE_ME_ACL_PASSWORD>

# ������� ������ Gateway � PostgreSQL runtime (�� �2)
GATEWAY_DB_USER=factory_gateway
GATEWAY_DB_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# ==============================================================================
# �������������� ��������� (�����������)
# ==============================================================================
# ������� ����������� (debug, info, warning, error)
LOG_LEVEL=info

# ������� ���� ��� �����������
TZ=Asia/Yekaterinburg

# ==============================================================================
# Keycloak (IdP / LDAP-федерация) — администратор (Keycloak 26+)
# ==============================================================================
# F1: Keycloak 26 использует KC_BOOTSTRAP_ADMIN_* вместо KEYCLOAK_ADMIN*
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# ==============================================================================
# Langfuse UI — OIDC-федерация через Keycloak (F2)
# ==============================================================================
# OIDC-клиент для Langfuse UI (регистрируется в Keycloak realm "factory")
AUTH_KEYCLOAK_CLIENT_ID=langfuse-ui
AUTH_KEYCLOAK_CLIENT_SECRET=<CHANGE_ME_FROM_KEYCLOAK_CLIENT>
