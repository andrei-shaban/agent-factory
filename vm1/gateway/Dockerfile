# vm1/gateway/Dockerfile
# syntax=docker/dockerfile:1
# ==============================================================================
# Dockerfile — AG-UI Gateway (FastAPI) / единый образ с Worker
# Production Blueprint v5.2 — ВМ №1
# ==============================================================================
# Единый образ с Worker (ВМ №2): разные entrypoints (uvicorn / taskiq worker).
# Python 3.14 — основная версия; при отсутствии бинарных wheels допускается
# fallback на 3.13 (изменить базовый образ, см. Blueprint v5.2 п. 3.6).
#
# Кодировка: UTF-8 без BOM, окончания строк LF.
#
# ------------------------------------------------------------------------------
# КОНТЕКСТ СБОРКИ (ВАЖНО)
# ------------------------------------------------------------------------------
# Сборка выполняется из КОРНЯ ВМ №1 (директория vm1/), а не из папки gateway/.
# Это необходимо, чтобы были доступны:
#   - ./gateway/requirements.txt   (зависимости)
#   - ./gateway/app/               (код приложения)
# Состав контекста ограничен файлом ./.dockerignore (секреты исключены).
#
# Команда сборки (из корня vm1/):
#   docker build -f gateway/Dockerfile -t factory/gateway:1.0.0 .
#
# ------------------------------------------------------------------------------
# ФИКСАЦИЯ БАЗОВОГО ОБРАЗА (Blueprint §5.1)
# ------------------------------------------------------------------------------
# Базовый образ задаётся через build-аргумент BASE_IMAGE. По умолчанию — тег,
# чтобы шаблон собирался «из коробки». Для продакционной сборки образ
# фиксируется по digest из инвентаризации внутреннего зеркала:
#
#   docker inspect --format='{{index .RepoDigests 0}}' python:3.14-slim
#
# Продакционная сборка (с фиксацией по digest и зеркалом PyPI):
#   docker build -f gateway/Dockerfile \
#     --build-arg BASE_IMAGE=python:3.14-slim@sha256:<digest-из-зеркала> \
#     --build-arg PIP_INDEX_URL=http://vm1-pypiserver:8080/simple/ \
#     -t factory/gateway:1.0.0 .
#
# ------------------------------------------------------------------------------
# КЭШИРОВАНИЕ
# ------------------------------------------------------------------------------
# Многоступенчатая сборка + кэш-монтирование (требуется BuildKit; включён по
# умолчанию в современных версиях Docker, иначе DOCKER_BUILDKIT=1).
# Кэшируются: скачанные .deb (/var/cache/apt), пакеты pip (/root/.cache/pip),
# а слой установки зависимостей не инвалидируется при изменении кода
# (код копируется последним).
# ==============================================================================

# Базовый образ: по умолчанию тег; в проде фиксируется по digest через --build-arg.
ARG BASE_IMAGE=python:3.14-slim

# ==============================================================================
# ЭТАП 1: СБОРКА ЗАВИСИМОСТЕЙ (с компиляцией и кэшированием)
# ==============================================================================
# Отвечает за системные заголовочные пакеты и компиляцию всех Python-зависимостей
# в изолированное виртуальное окружение. Результат копируется в финальный образ —
# сами компиляторы в прод не попадают.
FROM ${BASE_IMAGE} AS builder

# Не отключаем pip-кэш: он нужен для кэш-монтирования на шаге установки.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=100

# Внутреннее зеркало PyPI (Air-Gap). Передаётся как --build-arg.
ARG PIP_INDEX_URL
ARG PIP_EXTRA_INDEX_URL
ENV PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_EXTRA_INDEX_URL=${PIP_EXTRA_INDEX_URL}

WORKDIR /build

# Системные зависимости для компиляции (если нет бинарных wheels).
# Кэш: скачанные .deb сохраняются между сборками.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Изолированное виртуальное окружение для всех зависимостей.
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Копируем ТОЛЬКО файл зависимостей (--link: слой независим от родительского,
# лучше попадает в кэш). Изменения кода этот слой не инвалидируют.
COPY --link gateway/requirements.txt ./requirements.txt

# Установка зависимостей из внутреннего зеркала + проверка резолва.
# `pip check` падает на конфликтах зависимостей уже на этапе сборки, а не в рантайме.
# Кэш: скачанные пакеты сохраняются между сборками.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements.txt \
    && pip check

# ==============================================================================
# ЭТАП 2: ФИНАЛЬНЫЙ ОБРАЗ (рантайм)
# ==============================================================================
# Чистый рантайм-образ без компиляторов и заголовков — только то, что нужно для
# запуска шлюза. Все зависимости взяты из этапа builder.
FROM ${BASE_IMAGE} AS runtime

# ------------------------------------------------------------------------------
# Метаданные (OCI labels)
# ------------------------------------------------------------------------------
LABEL org.opencontainers.image.title="factory-gateway"
LABEL org.opencontainers.image.description="AG-UI Gateway (FastAPI) — приём RunAgentInput, постановка задач в Redis, SSE-relay"
LABEL org.opencontainers.image.vendor="Factory Agents Platform"
LABEL org.opencontainers.image.version="1.0.0"

# ------------------------------------------------------------------------------
# Переменные окружения
# ------------------------------------------------------------------------------
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Виртуальное окружение из этапа сборки (копируется ниже)
ENV PATH="/opt/venv/bin:$PATH"

# Пути к сертификатам будут переопределены в docker-compose.yml через volume
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# Отключение телеметрии (Air-Gap, Blueprint v5.2 п. 2)
ENV LANGSMITH_TRACING=false \
    LANGCHAIN_TRACING_V2=false \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1

# Режим работы
ENV ENVIRONMENT=production \
    LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Системные рантайм-зависимости (без компиляторов)
# ------------------------------------------------------------------------------
# Минимальный набор: только ca-certificates, wget и tini.
#   - wget  : используется healthcheck'ом (и в docker-compose) — curl удалён,
#             чтобы сократить поверхность (диагностика выполняется через wget).
#   - tini  : корректный PID 1 — проброс сигналов и реанимация зомби
#             (важно для uvicorn с несколькими воркерами).
# Кэш: скачанные .deb сохраняются между сборками.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        wget \
        tini \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------------------------
# Рабочая директория
# ------------------------------------------------------------------------------
WORKDIR /app

# ------------------------------------------------------------------------------
# Зависимости из этапа сборки
# ------------------------------------------------------------------------------
# Копируем готовое виртуальное окружение. Слой меняется только при изменении
# requirements, поэтому при обычных правках кода берётся из кэша.
COPY --link --from=builder /opt/venv /opt/venv

# ------------------------------------------------------------------------------
# Код приложения
# ------------------------------------------------------------------------------
# Копируется ПОСЛЕДНИМ: изменения кода не инвалидируют кэш установки
# зависимостей и системных пакетов.
COPY --link gateway/app/ ./app/

# ------------------------------------------------------------------------------
# Создание непривилегированного пользователя
# ------------------------------------------------------------------------------
# UID 10001 — стандартный диапазон для service accounts
RUN groupadd --system --gid 10001 factory \
    && useradd --system --uid 10001 --gid factory --home /app --shell /bin/false factory \
    && chown -R factory:factory /app

USER factory:factory

# ------------------------------------------------------------------------------
# Сигналы процесса
# ------------------------------------------------------------------------------
# Явный стоп-сигнал (дефолт; зафиксирован для документации). tini корректно
# передаёт SIGTERM дочернему uvicorn при `docker stop`.
STOPSIGNAL SIGTERM

# ------------------------------------------------------------------------------
# Healthcheck
# ------------------------------------------------------------------------------
# /health отвечает 200 без аутентификации — используется в docker-compose
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD ["wget", "--spider", "-q", "http://127.0.0.1:8000/health"]

# ------------------------------------------------------------------------------
# Порт
# ------------------------------------------------------------------------------
EXPOSE 8000

# ------------------------------------------------------------------------------
# Entrypoint
# ------------------------------------------------------------------------------
# tini как PID 1: корректная обработка сигналов и реанимация зомби.
#
# По умолчанию образ запускается как AG-UI Gateway (uvicorn).
# NOTE (фаза согласования ВМ №1 ↔ ВМ №2): согласно Blueprint §3.6, Gateway и
# Worker собираются из ОДНОГО образа с разными точками входа. Для режима Worker
# в образ будет дополнительно включён код воркера и его зависимости, а точка
# входа переопределяется на `taskiq worker ...`. На текущем этапе — Gateway.
ENTRYPOINT ["tini", "--"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4", "--log-level", "info"]