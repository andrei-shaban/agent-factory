{
  "identities": [
    {
      "name": "admin",
      "credentials": [
        {
          "accessKey": "${S3_ADMIN_ACCESS_KEY}",
          "secretKey": "${S3_ADMIN_SECRET_KEY}"
        }
      ],
      "actions": [
        "Admin",
        "Read",
        "Write",
        "List",
        "Tagging",
        "Delete"
      ]
    },
    {
      "name": "langfuse",
      "credentials": [
        {
          "accessKey": "${S3_ACCESS_KEY}",
          "secretKey": "${S3_SECRET_KEY}"
        }
      ],
      "actions": [
        "Read",
        "Write",
        "List"
      ],
      "buckets": [
        {
          "name": "langfuse-events",
          "actions": [
            "Read",
            "Write",
            "List"
          ]
        }
      ]
    },
    {
      "name": "factory",
      "credentials": [
        {
          "accessKey": "${S3_FACTORY_ACCESS_KEY}",
          "secretKey": "${S3_FACTORY_SECRET_KEY}"
        }
      ],
      "actions": [
        "Read",
        "Write",
        "List"
      ],
      "buckets": [
        {
          "name": "factory-artifacts",
          "actions": [
            "Read",
            "Write",
            "List"
          ]
        },
        {
          "name": "postgres-backups",
          "actions": [
            "Read",
            "Write",
            "List"
          ]
        }
      ]
    },
    {
      "name": "backup-readonly",
      "credentials": [
        {
          "accessKey": "${S3_BACKUP_RO_ACCESS_KEY}",
          "secretKey": "${S3_BACKUP_RO_SECRET_KEY}"
        }
      ],
      "actions": [
        "Read",
        "List"
      ],
      "buckets": [
        {
          "name": "postgres-backups",
          "actions": [
            "Read",
            "List"
          ]
        }
      ]
    }
  ],
  "buckets": [
    {
      "name": "langfuse-events",
      "force_path_style": true
    },
    {
      "name": "factory-artifacts",
      "force_path_style": true
    },
    {
      "name": "postgres-backups",
      "force_path_style": true
    }
  ]
}