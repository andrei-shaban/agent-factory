# vm2/sandbox/Dockerfile.toolset
# syntax=docker/dockerfile:1
# ==============================================================================
# Dockerfile.toolset — Базовый образ для песочниц gVisor (ВМ №2)
# Production Blueprint v5.3.1
# ==============================================================================

FROM python:3.14-slim AS base

LABEL org.opencontainers.image.title="factory-sandbox-toolset-base"
LABEL org.opencontainers.image.description="Базовый образ для изолированных песочниц gVisor"
LABEL org.opencontainers.image.vendor="Factory Agents Platform"
LABEL org.opencontainers.image.version="1.0.0"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=100 \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1

# ==============================================================================
# Системные зависимости
# ==============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && update-ca-certificates

# ==============================================================================
# Пользователь и права
# ==============================================================================
RUN groupadd --system --gid 10000 sandbox \
    && useradd --system --uid 10000 --gid sandbox --home /app --shell /bin/false sandbox

WORKDIR /app

# ==============================================================================
# E4: Установка базовых зависимостей (build-time)
# ==============================================================================
# Вариант 1: Air-Gap (wheels в контексте сборки)
# Вариант 2: Внутреннее зеркало PyPI (через --build-arg PIP_INDEX_URL)

ARG PIP_INDEX_URL
ARG TOOLSET_REQS=requirements.txt

# Попытка скопировать wheelhouse (air-gap)
COPY wheelhouse/ /tmp/wheelhouse/ 2>/dev/null || true

# Копируем файл требований
COPY ${TOOLSET_REQS} /tmp/requirements.txt

# Установка: сначала из wheelhouse (если есть), иначе из PIP_INDEX_URL
RUN if [ -d /tmp/wheelhouse ] && [ "$(ls -A /tmp/wheelhouse 2>/dev/null)" ]; then \
        pip install --no-index --find-links=/tmp/wheelhouse -r /tmp/requirements.txt; \
    elif [ -n "${PIP_INDEX_URL}" ]; then \
        pip install --index-url="${PIP_INDEX_URL}" -r /tmp/requirements.txt; \
    else \
        echo "ERROR: Neither wheelhouse nor PIP_INDEX_URL provided" && exit 1; \
    fi

# ==============================================================================
# E5: Код инструмента
# ==============================================================================
# Копируется из контекста сборки: toolsets/<name>/ → /app/tools/
COPY toolsets/ /app/tools/

# ==============================================================================
# Точка входа
# ==============================================================================
COPY entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

USER sandbox:sandbox

ENTRYPOINT ["/app/entrypoint.sh"]