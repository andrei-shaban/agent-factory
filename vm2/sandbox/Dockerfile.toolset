# ==============================================================================
# Dockerfile.toolset — Базовый образ для песочниц gVisor (ВM №2)
# Production Blueprint v5.2
# ==============================================================================
# Назначение: Изолированное выполнение недоверенного кода (инструменты агентов).
# Особенности:
#   - Минимальный attack surface (slim-образ, непривилегированный пользователь).
#   - Строгий запрет на сетевые загрузки: pip настроен на использование только
#     локального wheel-cache, смонтированного в контейнер read-only.
#   - Совместимость с gVisor (runsc): отсутствие специфичных syscall,
#     требующих привилегий.
# ==============================================================================

# Основная версия — 3.14-slim (согласно Blueprint v5.2 п. 3.6).
# Fallback на 3.13-slim допускается только при отсутствии бинарных wheels во внутреннем зеркале.
FROM python:3.14-slim AS base

# ==============================================================================
# Метаданные (OCI labels)
# ==============================================================================
LABEL org.opencontainers.image.title="factory-sandbox-toolset-base"
LABEL org.opencontainers.image.description="Базовый образ для изолированных песочниц gVisor"
LABEL org.opencontainers.image.vendor="Factory Agents Platform"
LABEL org.opencontainers.image.version="1.0.0"

# ==============================================================================
# Переменные окружения
# ==============================================================================
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=100 \
    # Строгий запрет на обращения в интернет для pip
    PIP_NO_INDEX=1 \
    # Путь к смонтированному read-only wheel-cache (см. docker-compose.yml)
    PIP_FIND_LINKS=/app/wheel-cache \
    # Отключение телеметрии и внешних загрузок (Air-Gap)
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1

# ==============================================================================
# Системные зависимости
# ==============================================================================
# Только минимально необходимые пакеты.
# ca-certificates — для доверия внутренним ресурсам.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && update-ca-certificates

# ==============================================================================
# Пользователь и права
# ==============================================================================
# Создание непривилегированного пользователя для запуска кода.
# UID 10000 — стандартный диапазон для sandbox-аккаунтов, легко отслеживается в аудите.
RUN groupadd --system --gid 10000 sandbox \
    && useradd --system --uid 10000 --gid sandbox --home /app --shell /bin/false sandbox

# ==============================================================================
# Рабочая среда
# ==============================================================================
WORKDIR /app

# ==============================================================================
# Установка зависимостей toolset
# ==============================================================================
# ARG позволяет передавать конкретный файл требований при сборке
# (например: docker build --build-arg TOOLSET_REQS=excel-reqs.txt -t toolset-excel .)
ARG TOOLSET_REQS=requirements.txt

# Копируем файл требований (если он существует в контексте сборки)
COPY ${TOOLSET_REQS} /tmp/requirements.txt

# Установка зависимостей строго из локального wheel-cache.
# Если пакета нет в кэше, pip завершится с ошибкой (что и требуется по безопасности).
RUN if [ -f /tmp/requirements.txt ]; then \
        pip install --no-cache-dir -r /tmp/requirements.txt || exit 1; \
    fi

# ==============================================================================
# Точка входа
# ==============================================================================
# Скрипт, который принимает команду на выполнение от воркера.
COPY entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Смена пользователя на непривилегированного перед запуском
USER sandbox:sandbox

# Точка входа по умолчанию
ENTRYPOINT ["/app/entrypoint.sh"]