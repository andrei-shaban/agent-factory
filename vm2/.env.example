# vm2/.env.example
# ==============================================================================
# Production Blueprint v5.2 — ВМ №2: Вычисления, песочницы, данные агентов
# ==============================================================================
# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env
#   nano .env
#
# ВАЖНО:
#   - Все пароли должны быть сильными (минимум 32 символа, случайные).
#   - Для генерации используйте: openssl rand -base64 32
#   - Переменные LANGFUSE_*, S3_* должны совпадать с .env на ВМ №1.
#   - GATEWAY_DB_USER/PASSWORD должны совпадать с аналогичными в vm1/.env.
# ==============================================================================

# ==============================================================================
# Сеть / публикация портов для ВМ №1
# ==============================================================================
# Адрес хоста ВМ №1, на который публикуются порты для нужд ВМ №2:
#   - 3000 — инжест трейсов в Langfuse (воркер ВМ №2)
#   - 8080 — зеркало PyPI (воркер ВМ №2)
VM1_HOST_IP=10.0.0.1

# ==============================================================================
# PostgreSQL Runtime & RAG (ВМ №2)
# ==============================================================================
# Суперпользователь контейнера (для init-скриптов)
POSTGRES_RUNTIME_USER=factory_runtime
POSTGRES_RUNTIME_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# Владелец БД factory (реестр ранов, чекпоинты)
FACTORY_DB_USER=factory_owner
FACTORY_DB_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# Пользователь Worker (LangGraph, чекпоинты, все таблицы)
WORKER_DB_USER=factory_worker
WORKER_DB_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# Пользователь Gateway (только таблица runs, read/write)
# Должен строго совпадать с GATEWAY_DB_USER в vm1/.env
GATEWAY_DB_USER=factory_gateway
GATEWAY_DB_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# Лимитирование памяти PostgreSQL (исключение конкуренции с Redis и песочницами)
# Рекомендуется: shared_buffers = 2GB, work_mem = 256MB, maintenance_work_mem = 512MB
POSTGRES_SHARED_BUFFERS=2GB
POSTGRES_WORK_MEM=256MB
POSTGRES_MAINTENANCE_WORK_MEM=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=6GB

# ==============================================================================
# Redis — фабрика (ВМ №2)
# ==============================================================================
# Очередь ранов + Streams для реконнекта.
# Локально к воркеру (без TLS), AOF на отдельном томе.
# ACL agui_svc для доступа из gateway (ВМ №1) по TLS.
REDIS_FACTORY_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>
REDIS_FACTORY_ACL_PASSWORD=<CHANGE_ME_ACL_PASSWORD>

# Лимит памяти Redis (должен быть меньше общего объёма RAM с запасом для песочниц)
REDIS_MAXMEMORY=4gb

# ==============================================================================
# Worker (единый Python-образ с gateway)
# ==============================================================================
# URL PostgreSQL Runtime (для Worker)
WORKER_POSTGRES_URL="postgresql+asyncpg://${WORKER_DB_USER}:${WORKER_DB_PASSWORD}@postgres-runtime:5432/factory"

# URL Redis фабрики (для Worker, локально без TLS)
WORKER_REDIS_URL="redis://:${REDIS_FACTORY_PASSWORD}@redis-factory:6379"

# ==============================================================================
# Langfuse (ВМ №1) — observability
# ==============================================================================
# API-ключи Langfuse (должны совпадать с .env на ВМ №1)
# Создаются в Langfuse UI после первого запуска на ВМ №1
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# URL Langfuse web на ВМ №1 (через выделенный порт хоста, минуя oauth2-proxy)
LANGFUSE_HOST="http://${VM1_HOST_IP}:3000"

# ==============================================================================
# SeaweedFS / S3 — «Водоросли» (ВМ №2)
# ==============================================================================
# S3-ключи для доступа к SeaweedFS (должны совпадать с seaweedfs/s3.json и .env на ВМ №1)
S3_ACCESS_KEY=<SEAWEEED_S3_KEY>
S3_SECRET_KEY=<SEAWEEED_S3_SECRET>

# URL S3-эндпоинта SeaweedFS (локально на ВМ №2)
SEAWEEED_S3_ENDPOINT=http://seaweedfs-s3:8333

# Бакеты SeaweedFS
SEAWEEED_S3_BUCKET_FACTORY=factory-artifacts
SEAWEEED_S3_BUCKET_LANGFUSE=langfuse-events
SEAWEEED_S3_BUCKET_BACKUPS=postgres-backups

# Репликация SeaweedFS (001 = одна копия на одном volume-сервере)
SEAWEEED_REPLICATION=001

# ==============================================================================
# mTLS — внешние интеграции
# ==============================================================================
# Пути к mTLS-сертификатам (монтируются в контейнер worker)
# Корпоративный Root CA (для проверки серверных сертификатов .228, ВМ №4)
MTLS_CA_CERT_PATH=/etc/certs/corp-ca.crt

# Клиентский сертификат и ключ воркера (для аутентификации на .228, ВМ №4, рабочей станции)
MTLS_CLIENT_CERT_PATH=/etc/certs/vm2-client.crt
MTLS_CLIENT_KEY_PATH=/etc/certs/vm2-client.key

# ==============================================================================
# GPU-узел (.228) — инференс и распознавание документов
# ==============================================================================
# URL mTLS-шлюза GPU-узла (единая точка входа для LLM и OCR)
GPU_ENDPOINT_URL=https://gpu-node.corp.example.com:443

# Таймауты для LLM-запросов (секунды)
GPU_LLM_TIMEOUT=600
GPU_LLM_STREAM_TIMEOUT=3600

# Таймауты для OCR-запросов (секунды)
GPU_OCR_TIMEOUT=120

# Имя модели LLM (автообнаружение через /v1/models, если пусто)
# Если заполнено — должно точно совпадать с --alias в llama-server
GPU_LLM_MODEL_NAME=

# ==============================================================================
# Корпоративное хранилище данных (ВМ №4) — мастер-данные
# ==============================================================================
# Учётная запись для чтения мастер-данных (read-only, mTLS)
CORP_PG_USER=factory_reader
CORP_PG_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# URL корпоративного PostgreSQL (ВМ №4) с mTLS
# sslmode=verify-full — проверка серверного сертификата по CA
# sslrootcert, sslcert, sslkey — пути к сертификатам внутри контейнера
CORP_PG_URL="postgresql+asyncpg://${CORP_PG_USER}:${CORP_PG_PASSWORD}@vm4-postgres.corp.example.com:5432/corp_data?sslmode=verify-full&sslrootcert=/etc/certs/corp-ca.crt&sslcert=/etc/certs/vm2-client.crt&sslkey=/etc/certs/vm2-client.key"

# ==============================================================================
# Рабочая станция (внешний контур) — бизнес-операции (Этап 2)
# ==============================================================================
# URL рабочей станции (mTLS)
WORKSTATION_URL=https://workstation.corp.example.com:443

# Таймаут для запросов к рабочей станции (секунды)
WORKSTATION_TIMEOUT=30

# ==============================================================================
# Внутреннее зеркало PyPI (ВМ №1) — wheels для песочниц
# ==============================================================================
# URL PyPI-зеркала на ВМ №1 (через выделенный порт хоста)
PYPI_MIRROR_URL="http://${VM1_HOST_IP}:8080"

# ==============================================================================
# Бэкапы PostgreSQL Runtime
# ==============================================================================
# Включить WAL-архивацию в SeaweedFS
POSTGRES_WAL_ARCHIVE_ENABLED=true

# Путь к WAL-архиву (внутри контейнера PostgreSQL)
POSTGRES_WAL_ARCHIVE_PATH=/var/lib/postgresql/wal-archive

# URL S3 для бэкапов (SeaweedFS на ВМ №2)
POSTGRES_BACKUP_S3_ENDPOINT=http://seaweedfs-s3:8333
POSTGRES_BACKUP_S3_BUCKET=postgres-backups

# Расписание бэкапов (cron-формат)
POSTGRES_BACKUP_SCHEDULE=0 2 * * *   # ежедневно в 02:00

# Ретенция бэкапов (дни)
POSTGRES_BACKUP_RETENTION_DAYS=30

# ==============================================================================
# Песочницы (Tools Sandbox)
# ==============================================================================
# Лимиты ресурсов для песочниц (gVisor)
SANDBOX_CPU_LIMIT=2.0
SANDBOX_MEMORY_LIMIT=4g
SANDBOX_PIDS_LIMIT=256

# Таймаут исполнения инструментов в песочнице (секунды)
SANDBOX_TIMEOUT=300

# Путь к wheel-cache (монтируется read-only в песочницы)
WHEEL_CACHE_PATH=/app/wheel-cache

# ==============================================================================
# Дополнительные настройки
# ==============================================================================
# Уровень логирования (debug, info, warning, error)
LOG_LEVEL=info

# Часовой пояс для контейнеров
TZ=Asia/Yekaterinburg

# Отключение телеметрии (Air-Gap, Blueprint v5.2)
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1